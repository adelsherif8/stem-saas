APP_NAME=Stem SaaS
ENVIRONMENT=development

# Local quickstart uses SQLite; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./stemsaas.db
REDIS_URL=redis://localhost:6379/0

# Set CELERY_EAGER=true to run jobs synchronously without a Redis broker
# (great for a quick `uvicorn`-only demo or tests).
CELERY_EAGER=false

JWT_SECRET=dev-secret-change-me-to-a-long-random-value-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

STORAGE_DIR=./storage

# Set DEMUCS_REAL=true to run real HT-Demucs (requires `pip install demucs`).
DEMUCS_REAL=false

FREE_TIER_MONTHLY_LIMIT=3
PRO_PRICE_USD=9.0

# Apply Alembic migrations when the API starts (set false to run
# `alembic upgrade head` as a separate release step instead).
AUTO_MIGRATE=true

# Postgres row-level security: auto | on | off (always off on SQLite).
RLS_ENFORCE=auto

# --- OAuth2 social login (authorization-code flow + PKCE) ---
# Leave a provider's id/secret empty to disable it: its endpoints then return
# 503 "not configured" and the web UI hides the button.
# Callback URL to register with each provider:
#   {OAUTH_REDIRECT_BASE_URL}/auth/oauth/google/callback
#   {OAUTH_REDIRECT_BASE_URL}/auth/oauth/github/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Where the browser goes after login; the JWT is appended as #access_token=...
OAUTH_SUCCESS_REDIRECT=/

# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
